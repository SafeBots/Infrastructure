# grub.cfg for the safebox image. Rendered by build-verity-root.sh with sed;
# placeholders: @ROOTHASH@ @KERNEL@ @INITRD@ @GRUB_PASSWORD_HASH@.
#
# This file is written directly, not generated by grub-mkconfig, so the
# bytes are deterministic across builds of the same inputs and so no distro
# hook can add a second menu entry, a recovery entry, or a BLS directory.
#
# measured: grub measures this file's commands into PCR 8 and the kernel/initrd into PCR 9
# (the measurement is done by the signed GRUB's tpm module, loaded below;
# the TPM-sealed pool key is bound to those PCRs, so any edit to this file
# or to the kernel command line produces a box that cannot open its pool).

# Superuser with a PBKDF2 hash. Any interactive action other than booting
# the unrestricted entry (editing the command line, the GRUB shell, choosing
# a non-default entry) requires this password. The passphrase is generated
# at build time and intentionally discarded; see make-grub-password.sh.
set superusers="safebox"
password_pbkdf2 safebox @GRUB_PASSWORD_HASH@

# No menu, no delay, no recovery entry. With timeout=0 and hidden style the
# only way to reach the menu is the keyboard interrupt on the console, which
# then needs the superuser password for anything but the default boot.
set timeout=0
set timeout_style=hidden
set default=0

# tpm: makes GRUB measure what it loads (PCR 8 for commands, 9 for files).
# Without it the sealing policy would be blind to the command line.
insmod part_gpt
insmod ext2
insmod tpm

# Locate /boot by label rather than by device path so the same file works
# on every cloud's disk controller naming.
search --no-floppy --label SAFEBOX-BOOT --set=root

# rd.shell=0 rd.emergency=reboot: a failure inside the initramfs reboots
# instead of dropping to dracut's root shell on the serial console. The
# unseal script may already have released the pool key and HMAC seed when
# it fails (a detached data disk, say), and the TPM policy stays satisfiable
# until PCR 15 is extended; a shell at that point would let the console
# operator run tpm2_unseal. The dracut module also masks the emergency and
# rescue units inside the initrd so the shell cannot come back by any
# other route.
#
# --unrestricted: booting this entry needs no password; it is the only entry
# and the box must come up unattended. Editing it still requires the
# superuser because 'superusers' is set. GRUB's rule is: entries listed as
# --unrestricted can be *booted* by anyone, while *editing* any entry or
# entering the command line always needs a superuser.
menuentry "safebox" --unrestricted --id safebox {
    linux /@KERNEL@ root=/dev/mapper/safebox-root ro systemd.verity_root_data=PARTLABEL=SAFEBOX-ROOT systemd.verity_root_hash=PARTLABEL=SAFEBOX-HASH roothash=@ROOTHASH@ systemd.volatile=overlay rd.zfs=1 rd.shell=0 rd.emergency=reboot safebox.datadisk=auto console=ttyS0,115200n8 lockdown=integrity
    initrd /@INITRD@
}
